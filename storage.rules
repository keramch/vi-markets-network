rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Public read for organizer, market and vendor images

    // Organizer images (logo, header, gallery), and posters for an organizer's
    // own markets: the organizer's owner or an admin
    match /organizers/{organizerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (firestore.get(/databases/(default)/documents/organizers/$(organizerId)).data.ownerId == request.auth.uid
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Before stage 1 (T128) organizer images lived under markets/<organizer>;
    // those files stay readable. New uploads here: unclaimed markets' images,
    // by an admin
    match /markets/{marketId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /vendors/{vendorId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (firestore.get(/databases/(default)/documents/vendors/$(vendorId)).data.ownerId == request.auth.uid
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Authenticated read for everything else
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

  }
}
