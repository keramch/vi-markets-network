{
  "rewrites": [
    {
      "source": "/markets/:slug/:event",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|Embedly|Iframely|vkShare|Mastodon|Bluesky|Cardyb).*"
        }
      ],
      "destination": "/api/preview?path=/markets/:slug/:event"
    },
    {
      "source": "/markets/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|Embedly|Iframely|vkShare|Mastodon|Bluesky|Cardyb).*"
        }
      ],
      "destination": "/api/preview?path=/markets/:slug"
    },
    {
      "source": "/vendors/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|Embedly|Iframely|vkShare|Mastodon|Bluesky|Cardyb).*"
        }
      ],
      "destination": "/api/preview?path=/vendors/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        }
      ]
    }
  ]
}
